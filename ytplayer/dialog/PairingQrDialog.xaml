<Window x:Class="ytplayer.dialog.PairingQrDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ytplayer.dialog"
        mc:Ignorable="d"
        Title="Pairing QR"
        Background="#EFEFEF"
        Width="480" Height="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>      <!-- 0: Instructions -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>         <!-- 2: QR image -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>      <!-- 4: Host picker -->
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>      <!-- 6: URI text (copy/paste fallback) -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>      <!-- 8: Close button -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Text="Scan this QR with BooDroid (or any QR scanner) to register this BooTube. The fingerprint embedded in the QR is used to verify the server, so install only from a trusted display."/>

        <Border Grid.Row="2" Background="White" Padding="10" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="QrImage" Stretch="Uniform" MaxHeight="320" MaxWidth="320"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Host:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="HostCombo" MinWidth="240" SelectionChanged="OnHostChanged"/>
        </StackPanel>

        <TextBox Grid.Row="6" x:Name="UriText" IsReadOnly="True" TextWrapping="Wrap"
                 FontFamily="Consolas" FontSize="11"
                 BorderThickness="1" Padding="6"/>

        <Button Grid.Row="8" Content="Close" Width="100" HorizontalAlignment="Center" Click="OnCloseClicked"/>
    </Grid>
</Window>
